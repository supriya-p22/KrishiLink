generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  name           String
  phone          String?        @unique
  email          String?        @unique
  role           String         @default("FARMER")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  farmerProfile  FarmerProfile?

  @@index([role])
}

model FarmerProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  location    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmerCrops FarmerCrop[]
  priceAlerts PriceAlert[]
}

model Crop {
  id           String         @id @default(cuid())
  name         String
  category     String
  createdAt    DateTime       @default(now())
  farmerCrops  FarmerCrop[]
  marketPrices MarketPrice[]
  buyerDemands BuyerDemand[]
  saleIntents  SaleIntent[]
  priceAlerts  PriceAlert[]

  @@unique([name, category])
}

model Market {
  id        String         @id @default(cuid())
  name      String
  location  String
  state     String?
  district  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  prices    MarketPrice[]
  priceAlerts PriceAlert[]

  @@unique([name, location])
  @@unique([name, state, district])
}

model Buyer {
  id           String         @id @default(cuid())
  name         String
  type         String
  location     String
  contact      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  buyerDemands BuyerDemand[]
  saleIntents  SaleIntent[]
}

model BuyerDemand {
  id           String    @id @default(cuid())
  buyerId      String
  cropId       String
  quantity     Decimal   @db.Decimal(12, 2)
  unit         String
  offeredPrice Decimal   @db.Decimal(12, 2)
  status       String
  validUntil   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  buyer        Buyer     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  crop         Crop      @relation(fields: [cropId], references: [id], onDelete: Cascade)
  saleIntents  SaleIntent[]

  @@index([buyerId])
  @@index([cropId])
  @@index([status])
  @@index([validUntil])
}

model FarmerCrop {
  id          String        @id @default(cuid())
  farmerId    String
  cropId      String
  quantity    Decimal       @db.Decimal(12, 2)
  unit        String
  harvestDate DateTime?
  createdAt   DateTime      @default(now())
  farmer    FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crop      Crop          @relation(fields: [cropId], references: [id], onDelete: Cascade)
  saleIntents SaleIntent[]

  @@unique([farmerId, cropId])
  @@index([cropId])
}

model MarketPrice {
  id             String    @id @default(cuid())
  cropId         String
  marketId       String
  price          Decimal   @db.Decimal(12, 2)
  unit           String
  recordedAt     DateTime  @default(now())
  minPrice       Decimal?  @db.Decimal(12, 2)
  maxPrice       Decimal?  @db.Decimal(12, 2)
  modalPrice     Decimal?  @db.Decimal(12, 2)
  arrivalDate    DateTime? @db.Date
  variety        String?
  grade          String?
  sourceName     String?
  sourceRecordId String?
  observationKey String?   @unique
  crop           Crop      @relation(fields: [cropId], references: [id], onDelete: Cascade)
  market         Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([cropId, recordedAt])
  @@index([marketId, recordedAt])
}

model SaleIntent {
  id            String       @id @default(cuid())
  farmerCropId  String
  buyerDemandId String
  buyerId       String
  cropId        String
  quantity      Decimal      @db.Decimal(12, 2)
  unit          String
  agreedPrice   Decimal      @db.Decimal(12, 2)
  status        String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  farmerCrop    FarmerCrop   @relation(fields: [farmerCropId], references: [id], onDelete: Cascade)
  buyerDemand   BuyerDemand  @relation(fields: [buyerDemandId], references: [id], onDelete: Cascade)
  buyer         Buyer        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  crop          Crop         @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([farmerCropId])
  @@index([buyerDemandId])
  @@index([buyerId])
  @@index([cropId])
  @@index([status])
}

enum PriceAlertCondition {
  AT_OR_ABOVE
  AT_OR_BELOW
}

model PriceAlert {
  id                          String              @id @default(cuid())
  farmerId                    String
  cropId                      String
  marketId                    String?
  targetPrice                 Decimal             @db.Decimal(12, 2)
  condition                   PriceAlertCondition
  unit                        String
  active                      Boolean             @default(true)
  lastTriggeredObservationKey String?
  lastTriggeredPrice          Decimal?            @db.Decimal(12, 2)
  lastTriggeredAt             DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  farmer                      FarmerProfile       @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crop                        Crop                @relation(fields: [cropId], references: [id], onDelete: Cascade)
  market                      Market?             @relation(fields: [marketId], references: [id], onDelete: SetNull)

  @@index([farmerId])
  @@index([cropId])
  @@index([marketId])
  @@index([active])
}
